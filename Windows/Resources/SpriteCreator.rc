#include <windows.h>
#include "..\..\Source\Resource.h"
#include "..\..\Source\Core\Version.h"

#pragma code_page(65001)

IDR_FONT_FA_SOLID        RCDATA "..\\..\\Dependencies\\Fonts\\fa-solid-900.ttf"

IDI_APPICON ICON "..\\..\\Source\\Resources\\icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    IDLER_VERSION_MAJOR,IDLER_VERSION_MINOR,IDLER_VERSION_PATCH,0
 PRODUCTVERSION IDLER_VERSION_MAJOR,IDLER_VERSION_MINOR,IDLER_VERSION_PATCH,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "CompanyName",      "Manifold"
            VALUE "Comments",         "Draws and animates the creatures of Manifold Idler."
            VALUE "FileDescription",  "Manifold Idler Sprite Creator"
            VALUE "FileVersion",      IDLER_VERSION_TEXT
            VALUE "InternalName",     "Manifold-Idler-Sprite-Creator"
            VALUE "OriginalFilename", "Manifold-Idler-Sprite-Creator.exe"
            VALUE "ProductName",      "Manifold Idler Sprite Creator"
            VALUE "ProductVersion",   IDLER_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0, 1200
    END
END
